# Node 12 matches the CI pipeline (Angular 8.1).
FROM node:12 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build -- bialydunajec-main

FROM nginx:alpine

COPY nginx.conf /etc/nginx/nginx.conf

WORKDIR /usr/share/nginx/html
COPY .htaccess .
COPY --from=build /app/dist/bialydunajec-main .
