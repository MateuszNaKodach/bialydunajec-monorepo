# eclipse-temurin replaces the deprecated openjdk images (openjdk:8-alpine3.9 is no longer on Docker Hub)
FROM eclipse-temurin:8-jdk AS stage-gradle-build
ARG GITHUB_ACTOR
ARG GITHUB_TOKEN

ENV GITHUB_ACTOR=${GITHUB_ACTOR}
ENV GITHUB_TOKEN=${GITHUB_TOKEN}

WORKDIR /app
COPY . .

# Tests are run by the CI pipeline; here we only need the runnable jar.
RUN ./gradlew --no-daemon -Prelease clean bootJar --stacktrace

FROM eclipse-temurin:8-jre AS stage-java-run
COPY --from=stage-gradle-build /app/build/libs/bialydunajec-backend-*.jar /bialydunajec-backend.jar

VOLUME /tmp

ENTRYPOINT ["java","-Djava.security.egd=file:/dev/./urandom","-jar","/bialydunajec-backend.jar"]
