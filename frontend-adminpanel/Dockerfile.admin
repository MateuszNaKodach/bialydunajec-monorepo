# node-sass 4.9.3 (locked) supports Node <= 10 and ships prebuilt binaries only for amd64,
# so the build stage runs as amd64 (emulated on Apple Silicon).
FROM --platform=linux/amd64 node:10 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build -- bialydunajec-admin

FROM nginx:alpine

COPY nginx.conf /etc/nginx/nginx.conf

WORKDIR /usr/share/nginx/html
COPY .htaccess .
COPY --from=build /app/dist/bialydunajec-admin .
